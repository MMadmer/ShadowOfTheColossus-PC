// sotc: FSR 3.1 frame generation with a HUD-less frame (vk_fsrfg.cpp). The SDK adds the HUD as
// the difference of the real frame and the HUD-less one to the interpolated scene, which lets
// the scene's motion show through an opaque UI layer and dims a fading one. Where the two frames
// differ (the HUD, the UI layer) the generated frame takes the real frame's pixel instead.

#version 450 core

layout (local_size_x = 8, local_size_y = 8) in;

layout (binding = 0, set = 0, rgba8) uniform readonly image2D frame_in;
layout (binding = 1, set = 0, rgba8) uniform readonly image2D hudless_in;
layout (binding = 2, set = 0, rgba8) uniform writeonly image2D generated;

layout (push_constant) uniform Params {
    uvec2 size;
} pc;

void main() {
    const ivec2 at = ivec2(gl_GlobalInvocationID.xy);
    if (at.x >= int(pc.size.x) || at.y >= int(pc.size.y)) {
        return;
    }
    const vec4 frame = imageLoad(frame_in, at);
    const vec4 hudless = imageLoad(hudless_in, at);
    // Outside the HUD both come from the same composite: equal to the bit.
    if (any(greaterThan(abs(frame.rgb - hudless.rgb), vec3(0.5 / 255.0)))) {
        imageStore(generated, at, frame);
    }
}
