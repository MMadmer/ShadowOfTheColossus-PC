// sotc: the generated frame of FSR 3.1 frame generation, built from the game's motion vectors
// (vk_fsrfg.cpp). FSR 3 blended the two game frames without lining them up (a hazy picture,
// objects doubled) and near the screen edges switched hard to one frame (a rectangle trailing
// the camera). Here each pixel half way between the frames is the point of the current frame
// that lands there: searched along the motion, the nearest one where layers overlap (a pillar
// hides the sky behind it). Its place in the previous frame comes from its own vector, so both
// samples show the same point; where they differ too much the point was hidden in the previous
// frame and the current one is shown alone. A frame's share fades out as its point nears the
// screen edge. The HUD pass lays the HUD over the result.

#version 450 core

layout (local_size_x = 8, local_size_y = 8) in;

layout (binding = 0) uniform sampler2D cur_scene;  // this game frame (FSR 3's interpolation source)
layout (binding = 1) uniform sampler2D prev_scene; // the previous game frame's
layout (binding = 2, rgba8) uniform image2D generated;
layout (binding = 3) uniform sampler2D mvec;       // curUV - prevUV at render size, sky filled
layout (binding = 4, rgba8) uniform readonly image2D frame_in;   // the real frame, HUD included
layout (binding = 5, rgba8) uniform readonly image2D prev_frame; // the previous real frame
layout (binding = 6) uniform sampler2D depth;      // render size, 0 at the near plane (fg_depth.comp)

layout (push_constant) uniform Params {
    uvec2 size;
    uint has_hudless; // cur_scene is the frame without its HUD: 1 the HUD pass lays it, 2 FSR 3 did
} pc;

const int kSteps = 8;

// Pixels from uv to the nearest screen edge, negative off screen.
float Inside(vec2 uv, vec2 pixels) {
    const vec2 d = min(uv, 1.0 - uv) * pixels;
    return min(d.x, d.y);
}

// The current frame's point that is at uv half way: c - mv(c) / 2 = uv, refined from `c`.
vec2 Refine(vec2 uv, vec2 c) {
    for (int i = 0; i < 3; ++i) {
        c = uv + 0.5 * texture(mvec, clamp(c, vec2(0.0), vec2(1.0))).xy;
    }
    return c;
}

void main() {
    const ivec2 at = ivec2(gl_GlobalInvocationID.xy);
    if (at.x >= int(pc.size.x) || at.y >= int(pc.size.y)) {
        return;
    }
    const vec4 fsr = imageLoad(generated, at);
    // Alpha is FSR 3's inpainting weight; the frame is presented opaque.
    vec4 out_color = vec4(fsr.rgb, 1.0);
    const vec2 pixels = vec2(pc.size);
    const vec2 uv = (vec2(at) + 0.5) / pixels;
    const vec2 mv0 = texture(mvec, uv).xy;
    // With the HUD-less frame the scene under the HUD is rebuilt too: the HUD pass lays the
    // real frame's HUD over it afterwards.
    const vec3 now = imageLoad(frame_in, at).rgb;
    if (pc.has_hudless == 2u &&
        any(greaterThan(abs(now - texelFetch(cur_scene, at, 0).rgb), vec3(0.5 / 255.0)))) {
        // FSR 3 composed the HUD itself (SOTC_FG_HUD_PASS=0): its HUD pixels stay.
        imageStore(generated, at, out_color);
        return;
    }
    if (pc.has_hudless == 0u && length(mv0 * pixels) > 2.0 &&
        all(lessThan(abs(now - imageLoad(prev_frame, at).rgb), vec3(3.0 / 255.0)))) {
        // Without the HUD-less frame the scene carries the HUD: a pixel that stayed put while the
        // camera moved is the HUD, shown as it is now instead of moved with the scene.
        imageStore(generated, at, vec4(now, 1.0));
        return;
    }

    // Candidates along the motion (up to twice this pixel's, for nearer layers moving faster);
    // the nearest one that really lands here.
    vec2 best = vec2(-1.0);
    float best_depth = 2.0;
    // The farthest layer seen on the way: its motion finds a point the current frame hides
    // (the background behind Wander while the camera turns around him).
    vec2 far_mv = mv0;
    float far_depth = -1.0;
    for (int i = 0; i <= kSteps; ++i) {
        const vec2 seed = uv + mv0 * (float(i) / float(kSteps));
        if (Inside(seed, pixels) < 0.0) {
            continue;
        }
        const float seed_depth = texture(depth, seed).r;
        if (seed_depth > far_depth) {
            far_depth = seed_depth;
            far_mv = texture(mvec, seed).xy;
        }
        const vec2 c = Refine(uv, seed);
        if (Inside(c, pixels) < 0.0 ||
            length((c - 0.5 * texture(mvec, c).xy - uv) * pixels) > 2.0) {
            continue;
        }
        const float d = texture(depth, c).r;
        if (d < best_depth) {
            best = c;
            best_depth = d;
        }
    }

    if (best.x >= 0.0) {
        const vec2 mv = texture(mvec, best).xy;
        const vec2 prev_uv = best - mv;
        const vec3 cur = texture(cur_scene, best).rgb;
        // Each frame's share fades out near its screen edge; the previous frame's also where it
        // shows something else (the point was hidden there).
        const float ramp = max(48.0, 0.5 * length(mv * pixels));
        const float w_cur = smoothstep(0.0, ramp, Inside(best, pixels));
        float w_prev = smoothstep(0.0, ramp, Inside(prev_uv, pixels));
        vec3 prev = cur;
        if (w_prev > 0.0) {
            prev = texture(prev_scene, prev_uv).rgb;
            const vec3 diff = abs(prev - cur);
            w_prev *= 1.0 - smoothstep(0.08, 0.2, max(diff.r, max(diff.g, diff.b)));
        }
        out_color.rgb = w_cur + w_prev > 0.0 ? (w_cur * cur + w_prev * prev) / (w_cur + w_prev) : cur;
    } else {
        // Not in the current frame (hidden there, or off screen): from the previous one, moved
        // with the farthest layer.
        const vec2 prev_uv = uv - 0.5 * far_mv;
        if (Inside(prev_uv, pixels) >= 0.0) {
            out_color.rgb = texture(prev_scene, prev_uv).rgb;
        }
    }
    imageStore(generated, at, out_color);
}
